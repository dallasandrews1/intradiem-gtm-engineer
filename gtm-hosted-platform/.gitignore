# Place this .gitignore at the ROOT of the repo you create.

# Python build artifacts
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Secrets: API keys live in the host's environment variables, NEVER in the repo
.env
*.key
*.pem

# Runtime data, not source (regenerated by the engines / daily run)
**/logs/
**/requests.jsonl
**/suppression_state.json
**/notified_state.json

# OS noise
.DS_Store
