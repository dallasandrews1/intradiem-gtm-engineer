<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.intradiem.signals.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/dallasandrews/Claude/Projects/Intradiem GTM Engineer/intradiem-signal-engine/run_daily.sh</string>
    </array>

    <!-- Runs every day at 7:00 AM local time. Change Hour/Minute to reschedule. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/dallasandrews/Claude/Projects/Intradiem GTM Engineer/intradiem-signal-engine/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dallasandrews/Claude/Projects/Intradiem GTM Engineer/intradiem-signal-engine/logs/launchd.err.log</string>
</dict>
</plist>
